{
  "name": "sitemorph",
  "version": "0.2.0",
  "description": "Morph any website into clean local HTML \u2014 rendered with a real browser, converted to readable Tailwind CSS by default.",
  "keywords": ["website", "export", "tailwind", "playwright", "mirror", "morph", "framer"],
  "license": "MIT",
  "bin": {
    "sitemorph": "scripts/extract.mjs"
  },
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--no-experimental-webstorage next dev --turbopack",
    "build": "NODE_OPTIONS=--no-experimental-webstorage next build",
    "start": "NODE_OPTIONS=--no-experimental-webstorage next start",
    "lint": "next lint",
    "api:dev": "node src/server/index.js",
    "api:start": "node src/server/index.js",
    "extract": "node scripts/extract.mjs",
    "vercel-build": "next build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.887.0",
    "@paper-design/shaders-react": "^0.0.52",
    "@radix-ui/react-accordion": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.2",
    "@types/canvas-confetti": "^1.9.0",
    "@vercel/analytics": "^1.5.0",
    "archiver": "^7.0.1",
    "canvas-confetti": "^1.9.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "lucide-react": "^0.511.0",
    "motion": "^12.12.1",
    "next": "15.3.2",
    "next-themes": "^0.4.6",
    "playwright": "^1.64.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5"
  }
}
